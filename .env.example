# ─── Database (Phase 1) ────────────────────────────────────────
# Neon Postgres. Pooled connection for app runtime, direct for Prisma migrations.
DATABASE_URL=
DIRECT_URL=

# ─── Auth (Phase 1) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth — https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Anthropic (Phase 5) ───────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Redis / Queue (Phase 4) ───────────────────────────────────
# Upstash REST (for rate-limit SDK)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Wire-protocol URL for BullMQ (rediss://default:...@...upstash.io:6379)
REDIS_URL=

# ─── Cloudflare R2 (Phase 4) ───────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=peep-artifacts

# ─── Proxy (Phase 4, optional) ─────────────────────────────────
BRIGHTDATA_PROXY_URL=

# ─── Webhooks (Phase 6) ────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=

# ─── Search provider (Phase 7) ─────────────────────────────────
# Pick one: Brave (cheaper, recommended) or SerpAPI
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# ─── Billing & ops (Phase 9) ───────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=

# ─── Worker tuning ─────────────────────────────────────────────
CONCURRENCY=3
