{
  "name": "@shownomore/peep-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Peep — scrape, crawl, search, and extract the web from Claude, Cursor, and any MCP client.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://peep.shownomore.com/docs/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stallone2K/peep.git",
    "directory": "packages/peep-mcp"
  },
